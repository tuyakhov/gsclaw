# GSClaw configuration. Copy to .env for local development (never commit .env).
# GSClaw refuses to start unless an authentication mode is configured. Pick ONE of the two modes
# below; the mode is detected from the variables you set.

# Only needed if you set variables for both modes: "service_account" or "oauth".
# GSCLAW_AUTH_MODE=service_account

# --- Mode A: service account (one Google identity for everyone) -------------------------------
# Service-account key JSON from Google Cloud (IAM → Service accounts → Keys → Add key → JSON).
# Paste the raw JSON on one line, or base64-encode it. Add the service account's client_email as
# a user on each Search Console property (Settings → Users and permissions).
GOOGLE_SERVICE_ACCOUNT_JSON=

# stdio only: path to the key file instead of GOOGLE_SERVICE_ACCOUNT_JSON.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Long random secret for HTTP: clients send it as `Authorization: Bearer <token>`, put it in the
# secret path /mcp/<token>, or enter it on GSClaw's sign-in page (OAuth clients such as claude.ai).
# It also signs you in to the dashboard. Required for HTTP; at least 32 characters.
# Generate: openssl rand -hex 32   (or: npx gsclaw generate-token)
GSCLAW_ACCESS_TOKEN=

# --- Mode B: Google OAuth (each person signs in with their own Google account) ----------------
# OAuth client from Google Cloud → APIs & Services → Credentials → Create credentials →
# OAuth client ID → Web application. Authorized redirect URI:
#   <PUBLIC_BASE_URL>/oauth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts every token and session GSClaw issues (GSClaw stores nothing). Required in OAuth mode;
# optional in service-account mode. At least 32 characters. Changing it signs everyone out.
# Generate: openssl rand -hex 32
# GSCLAW_ENCRYPTION_KEY=

# Who may sign in (comma-separated). Leave both empty to allow any Google account; each person
# still only sees the Search Console properties their own account can access.
# ALLOWED_GOOGLE_DOMAINS=example.com
# ALLOWED_GOOGLE_EMAILS=alice@example.com,bob@gmail.com

# PUBLIC_BASE_URL (below) is required in OAuth mode unless your platform provides it.

# --- Behaviour ------------------------------------------------------------------------------
# Enable submit_sitemap / delete_sitemap (requests the read/write Search Console scope; the
# service account or signed-in user needs Full permission). Default: false.
# GSCLAW_ALLOW_WRITES=false

# Service-account mode: accept the access token as a URL path segment (/mcp/<token>) for clients
# that support neither OAuth nor custom headers. Default: true.
# GSCLAW_SECRET_PATH=true

# Serve the web dashboard at / (sign in with GSCLAW_ACCESS_TOKEN, or with Google in OAuth mode).
# When false, / shows only a minimal "server is running" page and /api/* is disabled. Default: true.
# GSCLAW_DASHBOARD=true

# Public URL of this deployment. Auto-detected on Vercel, Netlify, Render, Railway,
# DigitalOcean and Fly.io; set it when running behind your own domain or proxy.
# PUBLIC_BASE_URL=https://gsclaw.example.com

# Extra browser origins allowed to call /mcp (comma-separated), e.g. a web-based MCP client.
# GSCLAW_ALLOWED_ORIGINS=http://localhost:6274

# OAuth clients may only redirect to loopback addresses and known MCP clients (claude.ai,
# claude.com, chatgpt.com, cursor.com, vscode.dev). Add more hosts here (comma-separated).
# GSCLAW_OAUTH_REDIRECT_HOSTS=mcp-client.example.com

# Requests per minute per client token (0 disables). Default: 120.
# GSCLAW_RATE_LIMIT_PER_MINUTE=120

# Seconds to cache identical Google API reads in memory (0 disables). Default: 300.
# GSCLAW_CACHE_TTL_SECONDS=300

# Max Search Analytics rows fetched per query when auto-paginating. Default: 25000.
# GSCLAW_MAX_ROWS=25000

# Max URLs per batch_inspect_urls call (URL Inspection quota: 2,000/day per property). Default: 50.
# GSCLAW_BATCH_INSPECT_MAX=50

# debug | info | warn | error | silent. Tokens and keys are never logged. Default: info.
# LOG_LEVEL=info

# --- Node server ----------------------------------------------------------------------------
# PORT=3000
# Bind address. Default: 0.0.0.0 when PORT is set (containers/PaaS), otherwise 127.0.0.1.
# HOST=127.0.0.1
