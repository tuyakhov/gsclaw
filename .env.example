# GSClaw configuration. Copy to .env for local development (never commit .env).
# GSClaw refuses to start unless an authentication mode is configured.

# --- Service-account mode -------------------------------------------------------------------
# Service-account key JSON from Google Cloud (IAM → Service accounts → Keys → Add key → JSON).
# Paste the raw JSON on one line, or base64-encode it. Add the service account's client_email as
# a user on each Search Console property (Settings → Users and permissions).
GOOGLE_SERVICE_ACCOUNT_JSON=

# stdio only: path to the key file instead of GOOGLE_SERVICE_ACCOUNT_JSON.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Long random secret that HTTP clients must present, as `Authorization: Bearer <token>` or in
# the secret path /mcp/<token>. Required for HTTP; at least 32 characters.
# Generate: openssl rand -hex 32   (or: npx gsclaw generate-token)
GSCLAW_ACCESS_TOKEN=

# --- Behaviour ------------------------------------------------------------------------------
# Enable submit_sitemap / delete_sitemap (requests the read/write scope; the service account
# needs Full permission). Default: false.
# GSCLAW_ALLOW_WRITES=false

# Accept the access token as a URL path segment (/mcp/<token>) for clients that cannot send
# headers. Default: true.
# GSCLAW_SECRET_PATH=true

# Serve the web dashboard at / (sign in with GSCLAW_ACCESS_TOKEN). When false, / shows only a
# minimal "server is running" page and /api/* is disabled. Default: true.
# GSCLAW_DASHBOARD=true

# Public URL of this deployment. Auto-detected on Vercel, Netlify, Render, Railway,
# DigitalOcean and Fly.io; set it when running behind your own domain or proxy.
# PUBLIC_BASE_URL=https://gsclaw.example.com

# Extra browser origins allowed to call /mcp (comma-separated), e.g. a web-based MCP client.
# GSCLAW_ALLOWED_ORIGINS=http://localhost:6274

# Requests per minute per client token (0 disables). Default: 120.
# GSCLAW_RATE_LIMIT_PER_MINUTE=120

# Seconds to cache identical Google API reads in memory (0 disables). Default: 300.
# GSCLAW_CACHE_TTL_SECONDS=300

# Max Search Analytics rows fetched per query when auto-paginating. Default: 25000.
# GSCLAW_MAX_ROWS=25000

# Max URLs per batch_inspect_urls call (URL Inspection quota: 2,000/day per property). Default: 50.
# GSCLAW_BATCH_INSPECT_MAX=50

# debug | info | warn | error | silent. Tokens and keys are never logged. Default: info.
# LOG_LEVEL=info

# --- Node server ----------------------------------------------------------------------------
# PORT=3000
# Bind address. Default: 0.0.0.0 when PORT is set (containers/PaaS), otherwise 127.0.0.1.
# HOST=127.0.0.1
